<Window x:Class="RevitApiOnline.Wpf.GridLearn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RevitApiOnline.Wpf"
             mc:Ignorable="d" 
        
             Height="300" Width="400">
    <Window.Resources>
        <Style x:Key="textBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Background" Value="Yellow"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style x:Key="lableStyle" TargetType="Label">
            <Setter  Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="5">
        
        <!--Bo cuc tong-->
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="50"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!--Bo cuc tong-->
        
        
        <TextBlock HorizontalAlignment="Stretch" Style="{StaticResource textBlockStyle}" Grid.Row="1" Grid.Column="1" Text="Wall Type"></TextBlock>
        <TextBlock Foreground="Blue" Background="Green" Grid.Row="1" Grid.Column="2" Text="Wall Type 2"></TextBlock>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="AA"/>
        <TextBlock Grid.Row="1" Grid.Column="3" >
            <Italic>AAA</Italic>  BBB
        </TextBlock>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border BorderThickness="1" BorderBrush="Black">
                <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="AAA"></Label>
            </Border>
            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0 1 1 1">
                <Label  Content="BBB"/>
            </Border>
            <Label Grid.ColumnSpan="2" VerticalContentAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Content="CCCCC" />

            <TextBox TextChanged="textBoxValueChanged" x:Name="textBoxDemo" VerticalContentAlignment="Center" Height="30" Width="80" Grid.ColumnSpan="2" Grid.Row="2" Text="CCC"> </TextBox>
        
        </Grid>

        <Button Click="btnClickOk" Width="80" Height="30" Grid.Row="4" Grid.Column="1" Content="OK"></Button>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" Orientation="Horizontal">
            <CheckBox x:Name="checkBoxAll" IsChecked="True" Content="All"></CheckBox>
            <CheckBox x:Name="checkBoxMade" Content="Male"></CheckBox>
            <CheckBox x:Name="checkBoxFeMale" Content="FeMale"></CheckBox>
        </StackPanel>

        <GroupBox Header="Radio Demo Yes No" Grid.Row="3" Grid.Column="0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <RadioButton Content="Yes"></RadioButton>
                <RadioButton IsChecked="True" Content="No"></RadioButton>
                <RadioButton Content="Maybe"></RadioButton>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.ColumnSpan="2" Header="Radio Male Female" Grid.Row="3" Grid.Column="1">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <RadioButton VerticalContentAlignment="Center">
                    <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                        <Label  VerticalContentAlignment="Top" Content="Made" Foreground="Red"/>
                        <Image Width="20"  Source="/Wpf/image1.png"/>
                    </StackPanel>
                </RadioButton>
                <Separator Width="15" Opacity="0"/>
                <RadioButton VerticalAlignment="Center"  IsChecked="True" Content="Female"></RadioButton>
            </StackPanel>
        </GroupBox>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBlock Text="AAAAA"/>
            </Grid>
            <Grid Grid.Column="2">
                <TextBlock Text="BBB"/>
            </Grid>
            <GridSplitter HorizontalAlignment="Center" HorizontalContentAlignment="Center" Width="1" BorderBrush="Black" BorderThickness="1" Grid.Column="1"></GridSplitter>
        </Grid>

    </Grid>
</Window>
