<Window x:Class="RevitApiOnline.CircleCanvas.CanvasWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RevitApiOnline.CircleCanvas"
             mc:Ignorable="d" 
             Width="500" Height="500">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="Rebar Number:"/>
        <TextBox TextChanged="textTextChanged" HorizontalAlignment="Left" Margin="150 0 0 0" Width="100" x:Name="txtRebarNumber" Text="5"/>
        <Canvas Grid.Row="1" x:Name="canvas" Width="400" Height="400">
            
        </Canvas>
    </Grid>
</Window>
