<Window x:Class="RevitApiOnline.FamilyChange.ChangeFamilyTypeWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RevitApiOnline.FamilyChange"
             mc:Ignorable="d" 
             Width="600" Height="600"
             d:DataContext="{d:DesignInstance local:GridDataContext}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Label Content="Family Category:"/>
            <Separator Opacity="0" Width="20"/>
            <ComboBox SelectionChanged="familyCategorySelectionChanged" Name="commboxFamilyCategory" Width="200"
                      SelectedItem="{Binding FamilyCategory, 
                      UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FamilyCategoryName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Button Click="btnAddClick" Grid.Row="1" Content="Add" Width="100" HorizontalAlignment="Left"/>

        <DataGrid SelectionMode="Single" x:Name="dataGridChangeType" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" ItemsSource="{Binding ObservableFamilyOriginTarget,
                UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Family" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectionChanged="comboboxFamilyChanged" ItemsSource="{Binding Families,
                                UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      SelectedItem="{Binding Family, UpdateSourceTrigger=PropertyChanged
                                        ,Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FamilyName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Origin Type" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding OriginType,UpdateSourceTrigger=PropertyChanged,
                                Mode=TwoWay}" ItemsSource="{Binding ListTypeVM,
                                                            UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="--->" Width="50">
                        
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Target Type" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding TargetType,UpdateSourceTrigger=PropertyChanged,
                                Mode=TwoWay}" ItemsSource="{Binding ListTypeVM,
                                                            UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                                       <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
