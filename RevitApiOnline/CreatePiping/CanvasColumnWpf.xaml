<Window x:Class="RevitApiOnline.CreatePiping.CanvasColumnWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RevitApiOnline.CreatePiping"
             mc:Ignorable="d" 
             Width="600" Height="600" Topmost="True">
    <Grid>

        <ScrollViewer x:Name="scrollView" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" 
                   PreviewMouseLeftButtonDown="scrollView_PreviewMouseLeftButtonDown"
                   PreviewMouseRightButtonDown="scrollView_PreviewMouseRightButtonDown" 
                   MouseMove="scrollView_MouseMove"
                   PreviewMouseWheel="scrollView_PreviewMouseWheel">
            <Canvas Name="columnCanvas">
                <Canvas.LayoutTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding ScaleCanvas, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                        ScaleY="{Binding ScaleCanvas,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>
                    </TransformGroup>
                </Canvas.LayoutTransform>
            </Canvas>
        </ScrollViewer>
    </Grid>
</Window>
