<Window x:Class="RevitApiOnline.ListBox.ListBoxWpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RevitApiOnline.ListBox"
             mc:Ignorable="d" 
             Width="400" Height="600" Topmost="True"
             WindowStartupLocation="CenterScreen"
             d:DataContext="{d:DesignInstance local:WallListBoxVM}"
             >
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <!--<ListBox x:Name="listBoxWall" SelectionMode="Single" SelectedItem="{Binding WallInfoSelected}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NameWall}"/>
                        <Separator Width="30" Opacity="0"/>
                        <TextBlock Text="{Binding LevelName}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>-->
        <ListView Name="listViewWall" >
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Wall Name" Width="250" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,
                                        Mode=TwoWay}" Unchecked="listViewUnChecked" Checked="listViewChecked" />
                                    <Separator Width="20" Opacity="0"/>
                                    <TextBlock Text="{Binding NameWall}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>


                    <GridViewColumn  DisplayMemberBinding="{Binding LevelName}" Width="100">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Click="levelHeaderClick" Tag="LevelName" Content="Level"/>
                        </GridViewColumn.Header>
                    </GridViewColumn>


                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontStyle="Italic" FontSize="14" FontWeight="Bold" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
        
        <Button Click="btnOk" Width="80" Grid.Row="1" Content="OK"/>
    </Grid>
</Window>
